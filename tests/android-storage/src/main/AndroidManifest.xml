<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Dukto storage checks">
        <provider android:name=".ShareTestProvider"
            android:authorities="dev.dukto.storagecheck.share"
            android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".TestDocumentsProvider"
            android:authorities="dev.dukto.storagecheck.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>
    <instrumentation android:name=".StorageChecks" android:targetPackage="dev.dukto.storagecheck" />
    <instrumentation android:name=".ShareChecks" android:targetPackage="dev.dukto.storagecheck" />
</manifest>
